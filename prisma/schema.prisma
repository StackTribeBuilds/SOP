// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  FOUNDER
  BUSINESS_ANALYST
  CEO
  CTO
  BDE
  DEVELOPER
  ADMIN
}

enum LeadStage {
  NEW
  CONTACTED
  CONNECTED
  QUALIFIED
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  COLD_OUTBOUND
  REFERRAL
  PARTNERSHIP
  LOCAL_NETWORK
  INBOUND
  SOCIAL_MEDIA
  WEBSITE
  OTHER
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  DELAYED
  BLOCKED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CLIENT_REVIEW
  APPROVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum ChangeRequestStatus {
  REQUESTED
  ESTIMATED
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

enum ExpenseCategory {
  SOFTWARE_TOOLS
  HOSTING
  INTERNET_PHONE
  OFFICE
  TRAVEL
  MARKETING
  LEGAL
  TAXES
  MISCELLANEOUS
}

enum WithdrawalType {
  SALARY
  REIMBURSEMENT
  ADVANCE
  BONUS
  OTHER
}

enum CashProbability {
  COMMITTED
  PROBABLE
  PIPELINE
}

enum TaskStatus {
  BACKLOG
  THIS_WEEK
  IN_PROGRESS
  IN_REVIEW
  CLIENT_REVIEW
  APPROVED
  DONE
}

// ============================================
// MODELS
// ============================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          Role
  phone         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  ownedLeads        Lead[]             @relation("LeadOwner")
  ownedProjects     Project[]          @relation("ProjectOwner")
  techProjects      Project[]          @relation("TechOwner")
  ownedInvoices     Invoice[]          @relation("InvoiceOwner")
  withdrawals       FounderWithdrawal[]
  tasks             Task[]             @relation("TaskAssignee")
  activities        Activity[]
  bdeDailyReports   BdeDailyReport[]
  founderDailyReports   FounderDailyReport[]
  founderWeeklyReports  FounderWeeklyReport[]
  founderMonthlyReports FounderMonthlyReport[]
}

model Lead {
  id              String     @id @default(cuid())
  company         String
  contactName     String
  phone           String?
  email           String?
  source          LeadSource
  requirement     String
  estimatedBudget Float?
  timeline        String?
  decisionMaker   String?
  stage           LeadStage  @default(NEW)
  nextAction      String
  nextActionDate  DateTime
  notes           String?
  
  // Qualification data
  businessDescription  String?
  problemToSolve       String?
  whoWillUse           String?
  whyBuilding          String?
  projectType          String?
  existingSystem       Boolean?
  integrationsNeeded   String?
  budgetConfirmed      Boolean  @default(false)
  paymentStructure     String?
  otherApprovers       String?
  
  lostReason      String?
  
  ownerId         String
  owner           User       @relation("LeadOwner", fields: [ownerId], references: [id])
  
  // Converts to client when won
  clientId        String?
  client          Client?    @relation(fields: [clientId], references: [id])
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([stage])
  @@index([ownerId])
}

model Client {
  id                    String   @id @default(cuid())
  company               String
  gstin                 String?
  address               String?
  
  // Contacts
  primaryContactName    String
  primaryContactPhone   String?
  primaryContactEmail   String?
  decisionMakerName     String?
  decisionMakerPhone    String?
  decisionMakerEmail    String?
  billingContactName    String?
  billingContactEmail   String?
  technicalContactName  String?
  technicalContactEmail String?
  
  communicationChannel  String?  @default("WhatsApp")
  workingHours          String?
  
  // Onboarding checklist
  agreementSigned       Boolean  @default(false)
  advanceReceived       Boolean  @default(false)
  clientInfoCollected   Boolean  @default(false)
  primaryContactConfirmed Boolean @default(false)
  decisionMakerConfirmed Boolean @default(false)
  commChannelEstablished Boolean @default(false)
  requirementsApproved  Boolean @default(false)
  assetsReceived        Boolean @default(false)
  timelineApproved      Boolean @default(false)
  milestonesEstablished Boolean @default(false)
  responsibilitiesDocumented Boolean @default(false)
  kickoffCompleted      Boolean @default(false)
  
  isOnboarded           Boolean  @default(false)
  isActive              Boolean  @default(true)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  leads                 Lead[]
  projects              Project[]
  invoices              Invoice[]
  payments              Payment[]
}

model Project {
  id              String        @id @default(cuid())
  name            String
  description     String?
  scope           String?
  exclusions      String?
  contractValue   Float
  currency        String        @default("INR")
  isRecurring     Boolean       @default(false)
  
  startDate       DateTime?
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  
  status          ProjectStatus @default(NOT_STARTED)
  health          ProjectHealth @default(ON_TRACK)
  completionPercentage Int      @default(0)
  
  estimatedHours  Float?
  actualHours     Float         @default(0)
  
  proposalData    Json?
  contractData    Json?
  
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  
  projectOwnerId  String
  projectOwner    User          @relation("ProjectOwner", fields: [projectOwnerId], references: [id])
  
  techOwnerId     String
  techOwner       User          @relation("TechOwner", fields: [techOwnerId], references: [id])
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Relations
  milestones      Milestone[]
  invoices        Invoice[]
  changeRequests  ChangeRequest[]
  tasks           Task[]

  @@index([status])
  @@index([clientId])
}

model Milestone {
  id            String          @id @default(cuid())
  name          String
  description   String?
  deliverables  String?
  dueDate       DateTime?
  completedDate DateTime?
  paymentAmount Float
  status        MilestoneStatus @default(PENDING)
  sortOrder     Int             @default(0)
  
  clientApprovalDate DateTime?
  clientApprovalNote String?
  
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  invoices      Invoice[]
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([projectId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  amount        Float
  currency      String        @default("INR")
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  paidAmount    Float         @default(0)
  paidDate      DateTime?
  lineItems     Json?
  
  probability   CashProbability @default(COMMITTED)
  probabilityPercent Int       @default(100)
  expectedCash  Float?
  
  nextAction    String?
  nextActionDate DateTime?
  notes         String?
  
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])
  
  milestoneId   String?
  milestone     Milestone?    @relation(fields: [milestoneId], references: [id])
  
  ownerId       String
  owner         User          @relation("InvoiceOwner", fields: [ownerId], references: [id])
  
  payments      Payment[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([clientId])
}

model Payment {
  id          String   @id @default(cuid())
  amount      Float
  currency    String   @default("INR")
  date        DateTime
  method      String?  // UPI, Bank Transfer, Cash, etc.
  reference   String?  // Transaction ID
  notes       String?
  
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([clientId])
}

model ChangeRequest {
  id              String              @id @default(cuid())
  crNumber        String              @unique
  description     String
  impactOnScope   String?
  impactOnTimeline String?
  estimatedHours  Float?
  additionalCost  Float?
  currency        String              @default("INR")
  
  status          ChangeRequestStatus @default(REQUESTED)
  
  clientApprovalDate DateTime?
  clientApprovalNote String?
  
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id])
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([projectId])
}

model CashFlowForecast {
  id            String          @id @default(cuid())
  weekNumber    Int
  weekStartDate DateTime
  weekEndDate   DateTime
  
  openingCash   Float
  
  committedIn   Float           @default(0)
  probableIn    Float           @default(0)
  pipelineIn    Float           @default(0)
  expectedIn    Float           @default(0)  // Total expected in
  
  expectedOut   Float           @default(0)
  closingCash   Float           @default(0)
  
  manualOverride Boolean        @default(false)
  notes         String?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([weekNumber, weekStartDate])
  @@index([weekStartDate])
}

model Expense {
  id          String          @id @default(cuid())
  description String
  amount      Float
  currency    String          @default("INR")
  category    ExpenseCategory
  date        DateTime
  isRecurring Boolean         @default(false)
  recurringDay Int?           // Day of month for recurring
  notes       String?
  
  // Optional project link
  projectId   String?
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
  @@index([category])
}

model FounderWithdrawal {
  id       String         @id @default(cuid())
  amount   Float
  currency String         @default("INR")
  date     DateTime
  type     WithdrawalType @default(SALARY)
  notes    String?
  
  userId   String
  user     User           @relation(fields: [userId], references: [id])
  
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([date])
  @@index([userId])
}

model BankBalance {
  id        String   @id @default(cuid())
  amount    Float
  currency  String   @default("INR")
  date      DateTime @default(now())
  notes     String?
  
  createdAt DateTime @default(now())

  @@index([date])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(BACKLOG)
  priority       Int        @default(0)
  estimatedHours Float?
  actualHours    Float      @default(0)
  
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  assigneeId     String?
  assignee       User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([projectId])
  @@index([status])
}

model Activity {
  id         String   @id @default(cuid())
  entityType String   // Lead, Client, Project, Invoice, Payment, etc.
  entityId   String
  action     String   // created, updated, status_changed, payment_received, etc.
  details    String?
  
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model BdeDailyReport {
  id               String   @id @default(cuid())
  date             DateTime
  newProspects     Int      @default(0)
  contacted        Int      @default(0)
  replies          Int      @default(0)
  qualified        Int      @default(0)
  meetingsBooked   Int      @default(0)
  followUps        Int      @default(0)
  proposalsRequested Int    @default(0)
  problems         String?
  tomorrowPriorities String?
  
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([date, userId])
  @@index([userId])
}

// Settings for cash floor, zones, etc.
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FounderDailyReport {
  id              String   @id @default(cuid())
  date            DateTime
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  bankBalance     Float?
  collectionsToday Float?
  overduePayments String?
  criticalIssues  String?
  completedYesterday String?
  happeningToday  String?
  blockedItems    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date, userId])
}

model FounderWeeklyReport {
  id              String   @id @default(cuid())
  weekStartDate   DateTime
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  moneyNotes      String?
  salesNotes      String?
  deliveryNotes   String?
  peopleNotes     String?
  decisions       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([weekStartDate, userId])
}

model FounderMonthlyReport {
  id              String   @id @default(cuid())
  month           Int
  year            Int
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  revenue         Float?
  collections     Float?
  grossMargin     Float?
  netProfit       Float?
  retrospective   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([month, year, userId])
}

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String   // Cloud URL or internal path
  isSop       Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Spreadsheet {
  id          String   @id @default(cuid())
  title       String
  embedUrl    String   // Google Sheets embed URL
  assignedTo  String?  // Optional user ID assignment
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
